<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/btnControlPanel"
            style="@style/ToggleButton"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:text="CONTROL PANEL"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogHistory"
            style="@style/ToggleButton"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:text="LOG / HISTORY"
            android:textSize="12sp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

    <ScrollView
        android:id="@+id/controlPanelContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toggleGroup">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Set Microphone Threshold -->
            <TextView
                android:id="@+id/threshText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Set Microphone Threshold"
                android:textColor="@color/white"
                android:textSize="16dp" />

            <SeekBar
                android:id="@+id/threshSeekBar"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:progressBackgroundTint="@color/white"
                android:thumbTint="@color/white" />

            <!-- Row: Save button + dB input side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/threshSaveBtn"
                    android:layout_width="96dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/purple"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Save" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/threshValueInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:suffixText="dB"
                    app:suffixTextColor="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/threshValueInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:padding="3dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white"
                        android:textSize="19sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Set Speaker Volume -->
            <TextView
                android:id="@+id/volumeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Set Speaker Volume"
                android:textColor="@color/white"
                android:textSize="16dp" />

            <SeekBar
                android:id="@+id/volumeSeekBar"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:progressBackgroundTint="@color/white"
                android:thumbTint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/volumeSaveBtn"
                    android:layout_width="96dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/purple"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Save" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/volumeValueInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:suffixText="dB"
                    app:suffixTextColor="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/volumeValueInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:padding="3dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white"
                        android:textSize="19sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

            <!-- Set Timer -->
            <TextView
                android:id="@+id/timerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/roboto_bold"
                android:text="Set Timer"
                android:textColor="@color/white"
                android:textSize="16dp" />

            <SeekBar
                android:id="@+id/timerSeekBar"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="32dp"
                android:progressBackgroundTint="@color/white"
                android:thumbTint="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/timerSaveBtn"
                    android:layout_width="96dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/purple"
                    android:fontFamily="@font/roboto_bold"
                    android:text="Save" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/timerValueInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:boxStrokeColor="@color/text_input_stroke"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:suffixText="secs"
                    app:suffixTextColor="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/timerValueInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto"
                        android:gravity="center_vertical"
                        android:inputType="number"
                        android:padding="3dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/white"
                        android:textSize="19sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Add this as a sibling to your controlPanelContainer ScrollView -->
    <LinearLayout
        android:id="@+id/logHistoryContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toggleGroup">

        <!-- Filter Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <!-- Date Filter Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterDate"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Date"
                android:textColor="@color/white"
                app:chipBackgroundColor="@android:color/transparent"
                app:chipIconTint="@color/white"
                app:chipStrokeColor="@color/white"
                app:chipStrokeWidth="1dp" />

            <!-- dB Filter Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterDb"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="dB Level"
                android:textColor="@color/white"
                app:chipBackgroundColor="@android:color/transparent"
                app:chipIconTint="@color/white"
                app:chipStrokeColor="@color/white"
                app:chipStrokeWidth="1dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Sort Button -->
            <ImageButton
                android:id="@+id/btnSort"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_sort"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#33FFFFFF" />

        <!-- Log List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="4dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>